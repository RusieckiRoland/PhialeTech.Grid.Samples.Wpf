<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PhialeTech.Grid.Samples.Wpf.SqliteBinding</RootNamespace>
    <PhialeDesignWpfVersion>0.1.0-preview.48</PhialeDesignWpfVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PhialeTech.Grid.Contracts" Version="2.0.0-preview.7" />
    <PackageReference Include="PhialeTech.Grid.Core" Version="2.0.0-preview.8" />
    <PackageReference Include="PhialeTech.Grid.Wpf" Version="2.0.0-preview.7" />
    <PackageReference Include="Phiale.Design.Wpf" Version="$(PhialeDesignWpfVersion)" />
    <PackageReference Include="UniversalInput.Contracts" Version="3.0.0-preview.3" />
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.15" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <Content Include="../../Data/warehouse-1000000.sqlite" Link="Data/warehouse-1000000.sqlite" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
