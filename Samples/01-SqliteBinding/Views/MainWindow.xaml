<Window
    x:Class="PhialeTech.Grid.Samples.Wpf.SqliteBinding.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:grid="clr-namespace:PhialeTech.PhialeGrid.Wpf.Controls;assembly=PhialeTech.Grid.Wpf"
    Title="Phiale.Grid · 01 · SQLite + MVVM"
    Width="1280"
    Height="760"
    MinWidth="640"
    MinHeight="400"
    Background="{DynamicResource Phiale.Design.Brush.Surface.Base.Light}">
    <DockPanel Margin="{DynamicResource Phiale.Design.Thickness.Form.Padding}">
        <StackPanel
            Margin="0,0,0,12"
            DockPanel.Dock="Top"
            IsEnabled="{Binding IsIdle}"
            Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="Rows to load: " />
            <ComboBox
                Width="180"
                Margin="8,0,12,0"
                ItemsSource="{Binding DatasetSizes}"
                SelectedItem="{Binding SelectedSize}"
                Style="{StaticResource Phiale.Design.Style.ComboBox}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding StringFormat={}{0:N0}}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button
                Command="{Binding ReloadCommand}"
                Content="Load snapshot"
                Style="{StaticResource Phiale.Design.Style.Button.Secondary}" />
        </StackPanel>
        <TextBlock
            DockPanel.Dock="Top"
            Style="{StaticResource Phiale.Design.Style.Text.Body}"
            Text="{Binding Status}" />
        <grid:PhialeGrid
            x:Name="StockGrid"
            CapabilityPolicy="{Binding Capabilities}"
            Columns="{Binding Columns}"
            DataPageSize="100"
            DataSession="{Binding DataSession}" Context="{Binding Grid}"
            EnableDataVirtualization="True"
            IsGridReadOnly="True"
            IsPagingEnabled="True"
            LanguageCode="en"
            ShowDiagnosticStatus="False"
            ShowFilterRow="False" />
    </DockPanel>
</Window>
