<Window x:Class="PhialeTech.Grid.Samples.Wpf.NestedGrid.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:config="clr-namespace:PhialeTech.Grid.Samples.Wpf.HttpRest.Configuration"
 xmlns:grid="clr-namespace:PhialeTech.PhialeGrid.Wpf.Controls;assembly=PhialeTech.Grid.Wpf"
 Title="Phiale.Grid · 08 · Tabela wewnątrz tabeli" Width="1160" Height="750" MinWidth="760" MinHeight="460"
 Background="{DynamicResource Phiale.Design.Brush.Surface.Base.Light}">
 <DockPanel Margin="{DynamicResource Phiale.Design.Thickness.Form.Padding}">
  <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
   <TextBlock Text="07 · Lokalizacja → jej wyposażenie" Style="{StaticResource Phiale.Design.Style.Text.Body}" />
   <TextBlock Text="Rozwiń lokalizację przyciskiem +. Wewnątrz pojawi się pełny PhialeGrid z jej rekordami. Rozwiń drugą lokalizację i porównaj dane." TextWrapping="Wrap" />
   <TextBlock Text="Każda tabela szczegółów ma własne filtry i zaznaczenie. Układ kolumn jest domyślnie wspólny dla tej relacji." TextWrapping="Wrap" />
  </StackPanel>
  <grid:PhialeGrid x:Name="LocationsGrid" Columns="{Binding Columns}" Context="{Binding Grid}" ShowDiagnosticStatus="False" IsGridReadOnly="True"
    IsPagingEnabled="False" EnableDataVirtualization="False" LanguageCode="pl">
   <grid:PhialeGrid.CapabilityPolicy><config:RestExamplePolicy/></grid:PhialeGrid.CapabilityPolicy>
  </grid:PhialeGrid>
 </DockPanel>
</Window>
