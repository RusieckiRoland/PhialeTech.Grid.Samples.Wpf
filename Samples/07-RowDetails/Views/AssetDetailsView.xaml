<UserControl x:Class="PhialeTech.Grid.Samples.Wpf.RowDetails.Views.AssetDetailsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Border Padding="16,10" Background="{DynamicResource Phiale.Design.Brush.Surface.Base.Light}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <TextBlock Grid.ColumnSpan="2" Text="{Binding Name}" FontWeight="SemiBold" Margin="0,0,0,8" />
   <TextBlock Grid.Row="1" Text="Cena jednostkowa"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UnitPrice}"/>
   <TextBlock Grid.Row="2" Text="Stan / przegląd" Margin="0,6,0,0"/>
   <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
    <TextBlock Text="{Binding Usage}" Margin="0,0,16,0"/><TextBlock Text="{Binding Inspection}"/>
   </StackPanel>
   <TextBlock Grid.Row="3" Text="Uwagi" Margin="0,6,0,0"/>
   <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Notes}" TextWrapping="Wrap" Margin="0,6,0,0"/>
  </Grid>
 </Border>
</UserControl>
