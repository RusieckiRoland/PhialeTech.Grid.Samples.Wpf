<Window x:Class="PhialeTech.Grid.Samples.Wpf.LocalEditing.Views.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:grid="clr-namespace:PhialeTech.PhialeGrid.Wpf.Controls;assembly=PhialeTech.Grid.Wpf"
 xmlns:config="clr-namespace:PhialeTech.Grid.Samples.Wpf.LocalEditing.Configuration"
 Title="Phiale.Grid · 05 · Zapis lokalny do SQLite" Width="1220" Height="760" MinWidth="820" MinHeight="480"
 Background="{DynamicResource Phiale.Design.Brush.Surface.Base.Light}">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibility"/></Window.Resources>
 <DockPanel Margin="{DynamicResource Phiale.Design.Thickness.Form.Padding}">
  <StackPanel DockPanel.Dock="Top">
   <TextBlock Text="05 · Zapis lokalny: buforowany albo natychmiastowy" TextWrapping="Wrap" Style="{StaticResource Phiale.Design.Style.Text.Body}" />
   <StackPanel Orientation="Horizontal" IsEnabled="{Binding CanChangeSaveMode}" Margin="0,6,0,6">
    <RadioButton Content="Zapis buforowany" IsChecked="{Binding IsBuffered}" GroupName="SaveMode" Margin="0,0,16,0"/>
    <RadioButton Content="Zapis natychmiastowy" IsChecked="{Binding IsImmediate}" GroupName="SaveMode"/>
   </StackPanel>
   <TextBlock Text="{Binding ModeExplanation}" TextWrapping="Wrap" Style="{StaticResource Phiale.Design.Style.Text.Body}" />
   <TextBlock Text="Panel Zmiany pokazuje pola przed/po edycji. Lista Kategoria jest zamknięta; Lokalizacja pozwala wpisać własną wartość. Pusta data oznacza brak planowanego przeglądu." TextWrapping="Wrap" Style="{StaticResource Phiale.Design.Style.Text.Body}" />
   <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Style="{StaticResource Phiale.Design.Style.Text.Body}" />
   <TextBlock Text="{Binding DatabasePath, StringFormat=Baza robocza: {0}}" TextWrapping="Wrap" Style="{StaticResource Phiale.Design.Style.Text.Body}" />
   <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
    <Button Visibility="{Binding IsBuffered, Converter={StaticResource BooleanToVisibility}}" Command="{Binding Grid.SaveCommand}" Style="{StaticResource Phiale.Design.Style.Button.Secondary}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Phiale.Design.Style.ActionGlyph}" Content="{StaticResource Phiale.Design.Geometry.Action.Save}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0"/><TextBlock Text="Zapisz przez ViewModel"/></StackPanel></Button>
    <Button Visibility="{Binding IsBuffered, Converter={StaticResource BooleanToVisibility}}" Command="{Binding Grid.DiscardCommand}" Style="{StaticResource Phiale.Design.Style.Button.Secondary}" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><ContentControl Style="{StaticResource Phiale.Design.Style.ActionGlyph}" Content="{StaticResource Phiale.Design.Geometry.Action.Discard}" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" Margin="0,0,6,0"/><TextBlock Text="Odrzuć zmiany"/></StackPanel></Button>
    <TextBlock Text="{Binding Grid.CurrentRecordId, StringFormat=Bieżący rekord: {0}}" VerticalAlignment="Center" />
   </StackPanel>
  </StackPanel>
  <grid:PhialeGrid x:Name="AssetsGrid" Columns="{Binding Columns}" Context="{Binding Grid}"
   IsGridReadOnly="False" HideUnavailableMenuItems="True" IsPagingEnabled="False" EnableDataVirtualization="False" LanguageCode="pl" ShowFilterRow="True">
   <grid:PhialeGrid.ChangePanelContent><grid:PhialeChangePanel /></grid:PhialeGrid.ChangePanelContent>
   <grid:PhialeGrid.ValidationPanelContent><grid:PhialeValidationPanel /></grid:PhialeGrid.ValidationPanelContent>
   <grid:PhialeGrid.CapabilityPolicy><config:EditingExamplePolicy /></grid:PhialeGrid.CapabilityPolicy>
  </grid:PhialeGrid>
 </DockPanel>
</Window>
